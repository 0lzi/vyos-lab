{# Setup Interfaces #}
{% for interface , network in networks.items() -%}
{% set address = interface.}
set interfaces ethernet {{ interface.interface }} address {{ interface.ip[inventory_hostname] }}
set interfaces ethernet {{ interface.interface }} description {{ interface.description }}

{# Set up DHCP-Server #}
{% if interface.dhcp is defined %}
set service dhcp-server shared-network-name {{ interface.description }} authoritative
set service dhcp-server shared-network-name {{ interface.description }} description '{{ interface.description }}'
set service dhcp-server shared-network-name {{ interface.description }} subnet {{ interface.address }} option default-router '{{ interface.gateway.split("/")[0] }}'
set service dhcp-server shared-network-name {{ interface.description }} subnet {{ interface.address }} option name-server '{{ interface.gateway.split("/")[0] }}'
set service dhcp-server shared-network-name {{ interface.description }} subnet {{ interface.address }} range 0 start '{{ interface.dhcp.start }}'
set service dhcp-server shared-network-name {{ interface.description }} subnet {{ interface.address }} range 0 stop '{{ interface.dhcp.stop }}'
set service dhcp-server shared-network-name {{ interface.description }} subnet {{ interface.address }} subnet-id '{{ interface.key }}'

{# Enable DNS forwarder #}
set service dns forwarding allow-from '{{ interface.cidr }}'
set service dns forwarding listen-address '{{ interface.gateway.split("/")[0] }}'
set service dns forwarding system

{# Set up SNAT #}
set nat source rule {{ loop.index }} description '{{ interface.description }} via eth1'
set nat source rule {{ loop.index }} outbound-interface name 'eth1'
set nat source rule {{ loop.index }} source address '{{ interface.cidr }}'
set nat source rule {{ loop.index }} translation address 'masquerade'

{% endif %}
{% endfor %}
